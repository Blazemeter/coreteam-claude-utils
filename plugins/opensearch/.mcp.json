{
  "mcpServers": {
    "opensearch-reader": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/server.py"],
      "env": {
        "OPENSEARCH_HOST": "${OPENSEARCH_HOST}",
        "OPENSEARCH_USER": "${OPENSEARCH_USER}",
        "OPENSEARCH_PASSWORD": "${OPENSEARCH_PASSWORD}",
        "OPENSEARCH_HOST_CI": "${OPENSEARCH_HOST_CI}",
        "OPENSEARCH_USER_CI": "${OPENSEARCH_USER_CI}",
        "OPENSEARCH_PASSWORD_CI": "${OPENSEARCH_PASSWORD_CI}",
        "OPENSEARCH_INDEX_CI": "${OPENSEARCH_INDEX_CI}",
        "OPENSEARCH_HOST_STAGING": "${OPENSEARCH_HOST_STAGING}",
        "OPENSEARCH_USER_STAGING": "${OPENSEARCH_USER_STAGING}",
        "OPENSEARCH_PASSWORD_STAGING": "${OPENSEARCH_PASSWORD_STAGING}",
        "OPENSEARCH_INDEX_STAGING": "${OPENSEARCH_INDEX_STAGING}",
        "OPENSEARCH_HOST_PROD": "${OPENSEARCH_HOST_PROD}",
        "OPENSEARCH_USER_PROD": "${OPENSEARCH_USER_PROD}",
        "OPENSEARCH_PASSWORD_PROD": "${OPENSEARCH_PASSWORD_PROD}",
        "OPENSEARCH_INDEX_PROD": "${OPENSEARCH_INDEX_PROD}"
      }
    }
  }
}
